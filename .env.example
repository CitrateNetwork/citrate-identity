# Citrate Identity (auth.citrate.ai) — local config
# Public issuer URL. In production this is https://auth.citrate.ai
ISSUER_URL=http://localhost:3000

# Port the provider listens on. Must agree with the host part of ISSUER_URL for local dev.
PORT=3000

# Web origin of the citrate-explorer relying party. The explorer redirects the
# browser to ${EXPLORER_ORIGIN}/auth/callback, which is registered as the
# client's redirect_uri. Defaults to the local dev explorer on :3001. In
# production this is https://explorer.citrate.ai.
EXPLORER_ORIGIN=http://localhost:3001

# Comma-separated high-entropy secrets used to sign/verify session + interaction
# cookies (tamper detection). Rotate by prepending a new key. Dev has a default.
COOKIE_KEYS=

# Postgres connection string backing the KYC claim store (TD-2). When set, KYC
# claims persist across restarts and are shared across instances (PgKycStore).
# When UNSET in dev, the in-memory store is used (with a warning). In PRODUCTION
# this MUST be set or the authority refuses to boot (assertProductionConfig).
# Stores ONLY the claim record — status/dates/vendor_ref — never PII.
DATABASE_URL=

# Redis connection string backing the HA / restart-safe authority state:
#   - the panva oidc-provider persistent adapter (sessions, grants, tokens,
#     authorization/device codes, interactions) — survives restart + multi-instance;
#   - the single-use SIWE nonce store — a nonce is consumable exactly once across
#     ALL instances (replay defence holds cluster-wide);
#   - the logout session bus — a logout published on one instance cascades to the
#     SSE subscribers on every other instance (cross-instance fan-out).
# When UNSET in dev, panva's in-memory adapter + in-memory nonce/bus are used (with
# a warning) — single-instance, state lost on restart. In PRODUCTION this MUST be
# set or the authority refuses to boot (assertProductionConfig, same posture as
# DATABASE_URL / COOKIE_KEYS). Example: redis://default:password@host:6379
REDIS_URL=

# IDP-S0 Privy custom-auth PoC. You (the repo owner) create a Privy app and paste its
# App ID here. The IDP issuer does NOT need this to run — it is documentation/config for
# the PoC harness only. See src/privy-custom-auth.md.
PRIVY_APP_ID=
