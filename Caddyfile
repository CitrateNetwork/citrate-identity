# Caddy reverse proxy for the Citrate OIDC authority.
#
# OPTIONAL ingress: this fronts the `identity` service with automatic HTTPS
# (Let's Encrypt). If your VPS already terminates TLS / has its own ingress,
# delete the `caddy` service from docker-compose.yml and point your proxy at
# identity:3000 instead — the app trusts X-Forwarded-* (provider.proxy = true),
# so discovery advertises https URLs and Secure cookies behave correctly behind
# any TLS terminator.
#
# {$ISSUER_HOST} is read from the environment (set ISSUER_HOST in your .env, e.g.
# auth.citrate.ai). Caddy provisions + renews the certificate for that hostname
# automatically; no manual cert wrangling.

# Global options. The default logger also carries Caddy's error log, which records
# the full request URI when a proxy upstream is down (for example during an
# identity restart). Redact OAuth callback query values there too.
{
	log default {
		output stderr
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
				replace error_description REDACTED
			}
			resp_headers>Location query {
				replace code REDACTED
				replace state REDACTED
				replace error_description REDACTED
				delete handle
				delete sub
			}
			wrap json
		}
	}
}

{$ISSUER_HOST} {
	encode zstd gzip

	# Forward the real client protocol/host so the app issues correct absolute
	# (https) discovery/issuer URLs and sets Secure cookies.
	reverse_proxy identity:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}

		# Let the load balancer / Caddy short-circuit on the app's own /health.
		health_uri /health
		health_interval 30s
		health_timeout 5s
	}

	# Reasonable security headers for an auth surface. HSTS is safe once HTTPS is
	# confirmed working for the host (Caddy serves HTTPS by default here).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# OAuth callbacks (/oauth/callback for Notion and Slack, /oauth/linkedin/callback)
	# carry a one-time `code` and the `state` in the query string. The access log
	# keeps the request but replaces those values, so they never reach the logs.
	log {
		output stdout
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
				replace error_description REDACTED
			}
			resp_headers>Location query {
				replace code REDACTED
				replace state REDACTED
				replace error_description REDACTED
				delete handle
				delete sub
			}
			wrap console
		}
	}
}

# Homestead connector broker (container `homestead-broker`, joined to this
# stack's docker network). Add this site only after the A record
# connect.citrate.ai -> the droplet exists (DNS-only), so the HTTP-01 challenge
# can succeed. Source of truth: citrate-homestead deploy/broker/CONNECT_BROKER.md.
#
# No `log` directive on purpose: a Caddy access log records the full request
# URI, and /oauth/callback carries the OAuth `code` and `state` in its query
# string. The broker writes its own redacted line per request.
connect.citrate.ai {
	encode zstd gzip

	request_body {
		max_size 16KiB
	}

	reverse_proxy homestead-broker:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		# Overwrites any client-supplied value; the broker rate-limits on it.
		header_up X-Real-IP {remote_host}

		health_uri /health
		health_interval 30s
		health_timeout 5s
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
	}

	# Handled errors are logged at DEBUG, so a broker outage or an oversized body
	# never writes the callback's code and state to the ERROR log. The answer is
	# a bare status code with the same security headers.
	handle_errors {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			X-Frame-Options "DENY"
			-Server
		}
		respond "{err.status_code}" {err.status_code}
	}
}
