# =============================================================================
# Citrate Identity (auth.citrate.ai) — PRODUCTION environment template.
#
# Copy to `.env` next to docker-compose.yml and fill EVERY required value before
# `docker compose up -d --build`. The authority fail-closes on boot in production
# (NODE_ENV=production) if COOKIE_KEYS / ISSUER_URL / DATABASE_URL / REDIS_URL are
# missing or unsafe (assertProductionConfig, TD-1) — it will refuse to start.
#
# Generate every secret with high entropy, e.g.:
#     openssl rand -hex 32
# NEVER commit the filled-in .env — only this template is tracked.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=production
# In-container listen port. Caddy/ingress proxies to this; keep it 3000 to match
# the Dockerfile EXPOSE + healthcheck + compose wiring.
PORT=3000

# ---- Issuer / public URL ----------------------------------------------------
# REQUIRED. The public HTTPS issuer. MUST NOT be a localhost/loopback host in prod.
# Discovery, the `iss` claim, and SIWE domain-binding all derive from this.
ISSUER_URL=https://auth.citrate.ai
# The bare issuer host Caddy obtains a TLS cert for (the host part of ISSUER_URL).
ISSUER_HOST=auth.citrate.ai

# ---- Cookie signing keys ----------------------------------------------------
# REQUIRED. Comma-separated high-entropy secrets signing the session + interaction
# cookies (tamper detection). Each key MUST be >= 32 chars. Rotate by PREPENDING a
# new key (old keys still verify). The dev-default key is rejected in production.
#   openssl rand -hex 32
COOKIE_KEYS=

# ---- Relying-party origins (CORS allow-list + redirect_uris) ----------------
# REQUIRED. Browser web origins of the first-party RPs. These are echoed for CORS
# on the authority's cross-origin routes and must NOT be localhost in prod.
EXPLORER_ORIGIN=https://explorer.citrate.ai
DASHBOARD_ORIGIN=https://dashboard.citrate.ai
# REQUIRED for memrizz login (the federated agent-memory webapp, formerly Mnemosyne).
# Echoed for CORS + registered as the memrizz RP redirect origin. Must NOT be localhost.
MEMRIZZ_ORIGIN=https://memrizz.citrate.ai
# OPTIONAL. Hosted citrate-studio web origin, only if studio runs as a web surface
# (the native shell uses loopback PKCE and needs no CORS). Leave blank otherwise.
STUDIO_ORIGIN=

# ---- Postgres (KYC claim store, TD-2) ---------------------------------------
# REQUIRED in production. With docker-compose these creds also configure the
# `postgres` service; DATABASE_URL is assembled from them by compose, but if you
# run an external database set DATABASE_URL directly instead.
POSTGRES_USER=citrate
POSTGRES_PASSWORD=
POSTGRES_DB=citrate_identity
# Set this directly ONLY if NOT using the bundled postgres service:
#   openssl rand -hex 32   # for POSTGRES_PASSWORD above
# DATABASE_URL=postgres://citrate:PASSWORD@db.internal:5432/citrate_identity

# ---- Redis (HA authority state: adapter + nonces + logout bus) --------------
# REQUIRED in production. With docker-compose this password also configures the
# `redis` service; REDIS_URL is assembled from it by compose. For an external
# Redis set REDIS_URL directly instead.
#   openssl rand -hex 32
REDIS_PASSWORD=
# REDIS_URL=redis://default:PASSWORD@redis.internal:6379

# ---- KYC vendor webhook -----------------------------------------------------
# REQUIRED to enable the KYC claim webhook (POST /kyc/_set, /kyc/_revoke). When
# unset those endpoints fail closed (disabled). Shared secret with the KYC vendor.
#   openssl rand -hex 32
KYC_WEBHOOK_SECRET=

# ---- KYC provider: Sumsub (COMP-S1, user-facing /kyc/start) -----------------
# Enables GET /kyc/start (the identity-verification kickoff). When KYC_PROVIDER is
# unset, /kyc/start returns 503 (disabled) — the rest of the app is unaffected.
# With KYC_PROVIDER=sumsub, ALL FOUR of APP_TOKEN/SECRET_KEY/WEBHOOK_SECRET/
# LEVEL_NAME are REQUIRED or the server refuses to boot. mode is auto-selected:
# prod when NODE_ENV/CITRATE_ENV=production, else Sumsub sandbox.
#
# Provision these from the Sumsub dashboard (the OPERATOR enters them — they must
# NOT be committed; the filled-in env is 0600 and gitignored). Do NOT use
# `mock`/`clear` in production (the factory refuses them).
#
# Secure entry (values never echoed / never leave your terminal):
#   ./scripts/set-kyc-env.sh                              # writes ./.env.kyc (0600, gitignored)
#   ./scripts/set-kyc-env.sh --append ./.env.production   # merge into a deploy env
KYC_PROVIDER=sumsub
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
# The level name you created in the Sumsub dashboard for BASIC_INDIVIDUAL (T3).
SUMSUB_LEVEL_NAME=basic-kyc-level
# OPTIONAL — defaults to https://api.sumsub.com when unset.
# SUMSUB_BASE_URL=https://api.sumsub.com

# ---- Citrate chain RPC (EIP-1271 smart-contract wallet logins) --------------
# OPTIONAL. RPC endpoint for chain 40204 used to verify EIP-1271 (Safe / contract
# wallet) SIWE signatures. When unset, only EOA (ECDSA) logins are accepted and
# 1271 logins are declined (fail closed). EOA + WalletConnect login work without it.
CITRATE_RPC_URL=https://rpc.citrate.ai

# ---- WalletConnect (interaction-page QR / mobile connector) -----------------
# OPTIONAL and NOT fail-closed. A WalletConnect Cloud project id surfaces the QR /
# mobile-wallet connector on the login page (in addition to injected wallets). When
# blank, only the injected (browser-extension) connector is shown — login still
# works. Get a free id at https://cloud.reown.com (formerly WalletConnect Cloud).
WALLETCONNECT_PROJECT_ID=
